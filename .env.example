# Base de datos
DATABASE_URL=postgresql://cobro_user:password@localhost:5432/cobro_db

# Aplicacion
NODE_ENV=production
PORT=4009
APP_URL=https://cobro.olcas.app
BETTER_AUTH_URL=https://cobro.olcas.app
BETTER_AUTH_SECRET=
AUTH_SECRET=
MASTER_EMAIL=prueba@olcas.app
MASTER_NAME=Administrador principal

# Email transaccional (SMTP2GO)
SMTP2GO_API_KEY=
EMAIL_FROM=Cobro <no-reply@olcas.app>

# Sanity Assets
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-09-01
SANITY_API_TOKEN=

# Limites configurables
MAX_FILE_SIZE_MB=25
MAX_BATCH_SIZE_MB=100
